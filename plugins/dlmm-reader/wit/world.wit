// SPDX-License-Identifier: MIT
//
// ZeroClaw tool-plugin world (wit/v0).
//
// === Pinning assumptions (bounty requirement) ===
//
// Bounty: "wit/v0 is experimental — no .frozen marker, the ABI can move."
//
// This file is pinned against:
//   * ZeroClaw runtime 0.8.4
//   * wit-bindgen 0.46.0 (see ../Cargo.lock)
//
// If either moves, regenerate with:
//   rustup target add wasm32-wasip2
//   cargo build --locked --target wasm32-wasip2 --release
// and re-test the host integration suite (tests/host_integration.rs).
//
// === Interface contract ===
//
// One component = one tool. The host invokes `execute` with JSON args; the
// plugin returns a JSON result or an error string. The host wraps both in a
// `Result<string, string>` envelope per the WIT schema below.

package zeroclaw:tool@0.1.0;

interface plugin {
    execute: func(args: string) -> result<string, string>;
}

world tool-plugin {
    export plugin;
}